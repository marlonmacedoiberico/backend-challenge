{
  "name": "clinicsay-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=html --reporter=lcov --include=dist/src/**/*.js --exclude=dist/tests/** node --test \"dist/tests/**/*.test.js\""
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "c8": "^9.1.0",
    "typescript": "^5.8.3"
  }
}
